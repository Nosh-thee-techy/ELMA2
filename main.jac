
import from graph { DashboardState, AreaView, PersonView, ReportView, TrustView }
import "./public/styles.css";

def risk_level(risk: int) -> str { return "Critical" if risk >= 70 else "High" if risk >= 45 else "Watch" if risk >= 25 else "Safe"; }
def risk_class(risk: int) -> str { return "critical" if risk >= 70 else "high" if risk >= 45 else "watch" if risk >= 25 else "safe"; }
def person_class(needs_visit: bool, acknowledged: bool) -> str { return "visit" if needs_visit else "ack" if acknowledged else "pending"; }
def seed_demo() -> DashboardState {
    areas = [AreaView(name="Industrial Area",river="Nairobi River",risk=8,eta=180,trend="watch",roads="Mombasa Road open",boost=0), AreaView(name="Mukuru",river="Nairobi River",risk=8,eta=180,trend="watch",roads="Mombasa Road open",boost=0), AreaView(name="Dandora",river="Nairobi River",risk=8,eta=180,trend="watch",roads="Outering Road open",boost=0), AreaView(name="Korogocho",river="Nairobi River",risk=8,eta=180,trend="watch",roads="Open",boost=0), AreaView(name="Kibera",river="Ngong River",risk=8,eta=180,trend="watch",roads="Open",boost=0), AreaView(name="Lang'ata",river="Ngong River",risk=8,eta=180,trend="watch",roads="Ngong Road open",boost=0), AreaView(name="South C",river="Ngong River",risk=8,eta=180,trend="watch",roads="Open",boost=0), AreaView(name="Westlands",river="Ngong River",risk=8,eta=180,trend="watch",roads="Waiyaki Way open",boost=0)];
    people = [PersonView(name="Amina",role="ward_officer",language="Swahili",area="Korogocho",vulnerability=1), PersonView(name="Otieno",role="chama_leader",language="English",area="Dandora",vulnerability=1), PersonView(name="Muthoni",role="mama_mboga",language="Swahili",area="Dandora",vulnerability=2), PersonView(name="Kip",role="boda_rider",language="Sheng",area="Mukuru",vulnerability=2), PersonView(name="Wanjiku",role="tenant_ground_floor",language="Swahili",area="Mukuru",vulnerability=4), PersonView(name="Mzee Kamau",role="elderly_resident",language="Swahili",area="Mukuru",vulnerability=5), PersonView(name="Brian",role="landlord",language="English",area="Industrial Area",vulnerability=2), PersonView(name="Nia",role="boda_rider",language="Sheng",area="Kibera",vulnerability=2), PersonView(name="Salma",role="chama_leader",language="Swahili",area="Lang'ata",vulnerability=2), PersonView(name="Joy",role="tenant_ground_floor",language="English",area="Lang'ata",vulnerability=4), PersonView(name="Peter",role="mama_mboga",language="Swahili",area="South C",vulnerability=2), PersonView(name="David",role="landlord",language="English",area="Westlands",vulnerability=1)];
    trusts = [TrustView(from_name="Amina",to_name="Otieno",weight=9), TrustView(from_name="Amina",to_name="Salma",weight=8), TrustView(from_name="Otieno",to_name="Muthoni",weight=8), TrustView(from_name="Otieno",to_name="Kip",weight=9), TrustView(from_name="Kip",to_name="Wanjiku",weight=8), TrustView(from_name="Muthoni",to_name="Mzee Kamau",weight=9), TrustView(from_name="Salma",to_name="Nia",weight=8), TrustView(from_name="Salma",to_name="Joy",weight=7)];
    return DashboardState(rain=0,minute=0,areas=areas,people=people,reports=[],trusts=trusts,resource_brief="No warnings. Keep shelter, medic and boat teams on standby.",escalations=0,first_ack=-1,verified_at=-1,warnings_at=-1);
}
def with_rain(state: DashboardState, rain: int) -> DashboardState {
    areas: list[AreaView]=[]; people: list[PersonView]=[]; score: int=0;
    for a in state.areas { factor=5 if a.river=="Nairobi River" else 4; score=8 if rain<30 else min(100,rain*factor+a.boost+a.eta//180); level="critical" if score>=70 else "high" if score>=45 else "watch" if score>=25 else "watch"; eta=max(12,180-score*2); road="avoid" if score>=65 else "caution" if score>=35 else "open"; road_name=a.roads.split(" ")[0]; areas=areas+[AreaView(name=a.name,river=a.river,risk=score,eta=eta,trend=level,roads=road_name+" "+road,boost=a.boost)]; }
    for p in state.people { found=[a for a in areas if a.name==p.area]; risk=found[0].risk if found else 8; warning=p.warning; if rain>=30 { warning=p.name+": Flood risk rising in "+p.area+". Move early, avoid low crossings and check in."; if p.role=="boda_rider" { warning=p.name+": Epuka low crossings in "+p.area+". Use high roads and check in."; } elif p.role=="tenant_ground_floor" { warning=p.name+": Move first: people, medicine, documents, then power. Leave the ground floor."; } elif p.role=="elderly_resident" { warning=p.name+": Your named neighbour Amina will check on you. Keep your phone and medicine close."; } elif p.role=="chama_leader" { warning=p.name+": Relay this warning to your circle and ask everyone to check in."; } } else { warning=""; }
        people=people+[PersonView(name=p.name,role=p.role,language=p.language,area=p.area,vulnerability=p.vulnerability,acknowledged=p.acknowledged,warning=warning,needs_visit=p.needs_visit,relay=p.relay)]; }
    return DashboardState(rain=rain,minute=state.minute,areas=areas,people=people,reports=state.reports,trusts=state.trusts,resource_brief="Stage shelter and medic resources near the highest-risk corridor. Arrange welfare visits for anyone unreachable.",escalations=state.escalations,first_ack=state.first_ack,verified_at=state.verified_at,warnings_at=state.warnings_at);
}
def:pub app -> JsxElement {
    has state: DashboardState=seed_demo(), tab: str="Responder Command", name: str="Kip", report_text: str="Water rising at the bridge", report_area: str="Mukuru", notice: str="", sms_text: str="", sms_log: list[str]=[];
    async def rain_changed(e: ChangeEvent) { state=with_rain(state,int(e.target.value)); if state.rain>=30 and state.warnings_at<0 { state=DashboardState(rain=state.rain,minute=state.minute,areas=state.areas,people=state.people,reports=state.reports,trusts=state.trusts,resource_brief=state.resource_brief,escalations=state.escalations,first_ack=state.first_ack,verified_at=state.verified_at,warnings_at=state.minute); } notice="Warnings sent."; }
    async def reset_demo { state=seed_demo(); name="Kip"; notice="Demo reset."; }
    async def safe_now { people: list[PersonView]=[]; for p in state.people { acknowledged_now=p.acknowledged; needs_visit_now=p.needs_visit; if p.name==name { acknowledged_now=True; needs_visit_now=False; } people=people+[PersonView(name=p.name,role=p.role,language=p.language,area=p.area,vulnerability=p.vulnerability,acknowledged=acknowledged_now,warning=p.warning,needs_visit=needs_visit_now,relay=p.relay)]; } first=state.first_ack; if first<0 and state.warnings_at>=0 { first=state.minute+2-state.warnings_at; } state=DashboardState(rain=state.rain,minute=state.minute+2,areas=state.areas,people=people,reports=state.reports,trusts=state.trusts,resource_brief=state.resource_brief,escalations=state.escalations,first_ack=first,verified_at=state.verified_at,warnings_at=state.warnings_at); notice="Marked safe."; }
    async def fast_forward_local { people: list[PersonView]=[]; visits=state.escalations; for p in state.people { needs=p.needs_visit; relay=p.relay; if p.warning and not p.acknowledged and p.vulnerability>=4 and not p.needs_visit { needs=True; relay="Visit requested: Amina"; visits=visits+1; } people=people+[PersonView(name=p.name,role=p.role,language=p.language,area=p.area,vulnerability=p.vulnerability,acknowledged=p.acknowledged,warning=p.warning,needs_visit=needs,relay=relay)]; } state=DashboardState(rain=state.rain,minute=state.minute+10,areas=state.areas,people=people,reports=state.reports,trusts=state.trusts,resource_brief=state.resource_brief,escalations=visits,first_ack=state.first_ack,verified_at=state.verified_at,warnings_at=state.warnings_at); notice="Ten simulated minutes passed."; }
    async def confirm(name_to_confirm: str) { people: list[PersonView]=[]; for p in state.people { people=people+[PersonView(name=p.name,role=p.role,language=p.language,area=p.area,vulnerability=p.vulnerability,acknowledged=True if p.name==name_to_confirm else p.acknowledged,warning=p.warning,needs_visit=False if p.name==name_to_confirm else p.needs_visit,relay="Visit confirmed by "+name_to_confirm if p.name==name_to_confirm else p.relay)]; } state=DashboardState(rain=state.rain,minute=state.minute+2,areas=state.areas,people=people,reports=state.reports,trusts=state.trusts,resource_brief=state.resource_brief,escalations=state.escalations,first_ack=state.first_ack,verified_at=state.verified_at,warnings_at=state.warnings_at); notice="Visit confirmed."; }
    async def send_report { if report_text.strip() { reports=state.reports+[ReportView(text=report_text,area=report_area,author=name,status="plausible" if state.rain>=30 else "unverified",reasoning="Local demo signal recorded for "+report_area+".",minute=state.minute+2)]; areas: list[AreaView]=[]; for a in state.areas { boost=12 if a.name==report_area and state.rain>=30 else a.boost; areas=areas+[AreaView(name=a.name,river=a.river,risk=min(100,a.risk+boost-a.boost),eta=a.eta,trend=a.trend,roads=a.roads,boost=boost)]; } state=DashboardState(rain=state.rain,minute=state.minute+2,areas=areas,people=state.people,reports=reports,trusts=state.trusts,resource_brief=state.resource_brief,escalations=state.escalations,first_ack=state.first_ack,verified_at=state.rain>=30 and state.warnings_at>=0 and state.minute+2-state.warnings_at or state.verified_at,warnings_at=state.warnings_at); notice="Report received."; } }
    async def send_sms(command: str) { sms_log=sms_log+["OUT: "+command,"IN: Local demo received the command."]; }
    people_warned=len([p for p in state.people if p.warning]); acknowledged=len([p for p in state.people if p.acknowledged]); critical_count=len([a for a in state.areas if a.risk>=70]); pending_visits=len([p for p in state.people if p.needs_visit]); matching=[p for p in state.people if p.name==name]; resident=matching[0] if matching else PersonView(); resident_areas=[a for a in state.areas if a.name==resident.area]; resident_area=resident_areas[0] if resident_areas else AreaView();
    return <main className="shell"><header className="topbar"><div className="brand"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="5"/><circle cx="20" cy="20" r="11"/><circle cx="20" cy="20" r="17"/></svg><div><strong>Wimbi</strong><small>warnings that ripple through trust</small></div></div><nav className="tabs">{for item in ["Resident","Community Leader","Responder Command","Accountability"] { <button className={"tab active" if tab==item else "tab"} onClick={lambda { tab=item; }}>{item}</button> }}</nav><div className="header-actions"><span className="sample">SAMPLE DATA</span><span className="clock">T+{state.minute} min</span><button className="outline" onClick={lambda { reset_demo(); }}>Reset demo</button></div></header><div className="status-strip"><span>Rain <b>{state.rain} mm/hr</b></span><span><b>{critical_count}</b> areas critical</span><span><b>{people_warned}</b> people warned</span><span><b>{acknowledged}</b> acknowledged</span></div>{notice and <div className="notice">{notice}</div>}
        {if tab=="Responder Command" { <section className="view"><div className="view-heading"><div><h1>Responder command</h1><p>Local sample simulation; no server connection required.</p></div><button className="primary" onClick={lambda { fast_forward_local(); }}>Fast-forward 10 min</button></div><div className="responder-grid"><div className="stack"><article className="panel"><h2>Rainfall</h2><strong className="big-number">{state.rain}<small> mm/hr</small></strong><input className="rain-slider" type="range" min="0" max="100" value={str(state.rain)} onChange={rain_changed}/><div className="ticks"><span>0 Dry</span><span>30 Heavy</span><span>60 Severe</span><span>100 Extreme</span></div></article><article className="panel"><h2>Risk by area</h2>{state.rain<30 and <p className="all-clear">Safe. No warnings issued.</p>}{for a in state.areas { <div className="risk-row"><span><b>{a.name}</b><small>{a.river}</small></span><span><i className={"risk-meter "+risk_class(a.risk)} style={{"width":str(a.risk)+"%"}}></i><b>{a.risk}%</b><small>{risk_level(a.risk)}</small></span><span>{a.eta} min</span><span>{a.roads}</span></div> }}</article></div><div className="stack"><article className="panel"><h2>Resource brief</h2><p>{state.resource_brief}</p><div className="resource-list"><span>Shelter</span><span>Medic</span><span>Boat</span></div></article><article className="panel"><h2>Escalations</h2>{pending_visits==0 and <p className="empty">No silent residents.</p>}{for p in state.people { if p.needs_visit { <p>{p.name} needs a visit, asked {p.relay}</p> } }}</article><article className="panel"><h2>Reports</h2>{len(state.reports)==0 and <p className="empty">No reports yet.</p>}{for r in state.reports { <div className="report-line"><span className={"badge "+r.status}>{r.status}</span><div><b>{r.area}</b><p>{r.text}</p><small>{r.reasoning}</small></div></div> }}</article></div></div></section> }
        elif tab=="Resident" { <section className="resident-area"><article className="resident-phone"><div className="notch"></div><label className="identity">I am <select value={name} onChange={lambda (e: ChangeEvent) { name=e.target.value; }}>{for p in state.people { <option value={p.name}>{p.name} ({p.role.replace("_"," ")})</option> }}</select></label><div className={"resident-alert "+risk_class(resident_area.risk)}><b>{risk_level(resident_area.risk)}: {resident_area.risk>=25 and "water expected in about "+str(resident_area.eta)+" min" or "All clear. No flood warning right now."}</b></div><article className="resident-warning"><span className="language-chip">{resident.language}</span><p>{resident.warning if resident.warning else "No flood warning right now."}</p></article><article className="resident-card"><h2>Avoid these roads</h2><span className="road-danger">{resident_area.roads}</span><h2>Safe route</h2><span className="road-safe">Use high ground and follow local guidance</span></article><article className="resident-card"><h2>Move first</h2><label><input type="checkbox"/> Gather people and medicine</label><label><input type="checkbox"/> Take documents and phone</label><label><input type="checkbox"/> Move to higher ground</label></article>{(resident.needs_visit or resident.relay) and <div className="neighbour-card">Your neighbour {resident.relay} will check on you</div>}<button className="primary safe-button" onClick={lambda { safe_now(); }}>{resident.acknowledged and "You are marked safe" or "I'm safe"}</button><details className="report-sheet"><summary>Report water here</summary><label>Area<select value={report_area} onChange={lambda (e: ChangeEvent) { report_area=e.target.value; }}>{for a in state.areas { <option value={a.name}>{a.name}</option> }}</select></label><textarea value={report_text} onChange={lambda (e: ChangeEvent) { report_text=e.target.value; }}/><button className="secondary" onClick={lambda { send_report(); }}>Submit report</button>{len(state.reports)>0 and <div className="verdict"><b>{state.reports[0].status}</b><p>{state.reports[0].reasoning}</p></div>}</details></article></section> }
        elif tab=="Community Leader" { <section className="view"><div className="view-heading"><div><h1>Community leader</h1><p>Local demo trust circle.</p></div><label className="select-label">Viewing as <select value={name} onChange={lambda (e: ChangeEvent) { name=e.target.value; }}>{for p in state.people { if p.role=="chama_leader" or p.role=="ward_officer" { <option value={p.name}>{p.name} ({p.role})</option> } }}</select></label></div>{pending_visits>0 and <div className="urgent-banner">{pending_visits} vulnerable people need a visit</div>}<div className="leader-grid"><article className="panel graph-panel"><h2>Trust graph</h2><svg className="trust-svg" viewBox="0 0 520 420"><circle cx="260" cy="210" r="140" className="graph-ring"/><line x1="260" y1="210" x2="130" y2="100" stroke="#2DD4BF" stroke-width="4"/><line x1="260" y1="210" x2="390" y2="100" stroke="#2DD4BF" stroke-width="3"/><line x1="260" y1="210" x2="130" y2="320" stroke="#2DD4BF" stroke-width="3"/><line x1="260" y1="210" x2="390" y2="320" stroke="#2DD4BF" stroke-width="2"/><circle cx="260" cy="210" r="40" className="graph-center"/><text x="260" y="215" text-anchor="middle" className="graph-label">{name}</text><circle cx="130" cy="100" r="27" className="graph-person"/><circle cx="390" cy="100" r="27" className="graph-person"/><circle cx="130" cy="320" r="27" className="graph-person"/><circle cx="390" cy="320" r="27" className="graph-person"/><text x="130" y="105" text-anchor="middle" className="graph-label">Otieno</text><text x="390" y="105" text-anchor="middle" className="graph-label">Salma</text><text x="130" y="325" text-anchor="middle" className="graph-label">Kip</text><text x="390" y="325" text-anchor="middle" className="graph-label">Nia</text></svg><div className="legend"><span>Pending</span><span>Acknowledged</span><span>Needs visit</span></div></article><article className="panel circle-panel"><h2>My circle</h2>{for p in state.people { <div className="circle-row"><div className={"status-mark "+person_class(p.needs_visit,p.acknowledged)}></div><div className="circle-copy"><b>{p.name}</b><small>{p.role} / {p.language} / {p.area}</small><small>Vulnerability {p.vulnerability} of 5 / {person_class(p.needs_visit,p.acknowledged)}</small>{p.warning and <p>{p.warning}</p>}</div>{p.needs_visit and <button className="small-outline" onClick={lambda { confirm(p.name); }}>Confirm visit</button>}</div> }}<button className="outline" onClick={lambda { state=with_rain(state,state.rain); notice="Warnings sent."; }}>Relay again</button></article></div></section> }
        else { <section className="view"><div className="view-heading"><div><h1>Accountability</h1><p>Metrics update live from local demo state.</p></div></div><div className="metric-grid"><article className="metric"><small>REACH</small><strong>{people_warned>0 and str(int(acknowledged*100/people_warned))+"%" or "-"}</strong><p>Acknowledged / warned</p></article><article className="metric"><small>FIRST ACKNOWLEDGEMENT</small><strong>{state.first_ack>=0 and str(state.first_ack)+" min" or "-"}</strong><p>Time from warning start</p></article><article className="metric"><small>ESCALATIONS</small><strong>{state.escalations}</strong><p>Visit requests</p></article><article className="metric"><small>FIRST VERIFIED REPORT</small><strong>{state.verified_at>=0 and str(state.verified_at)+" min" or "-"}</strong><p>Time from warning start</p></article></div><p className="footnote">All figures derive from this browser's sample state.</p></section> }}
        <footer>All people, places and reports are fictional sample data. Local demonstration mode.</footer></main>;
}
