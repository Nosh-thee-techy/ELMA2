
import from graph { DashboardState, PersonView, AreaView }
import from walkers { run_rainfall, acknowledge, fast_forward, submit_report, get_state, confirm_visit, reset_demo, ussd }

async def fetch_state() -> DashboardState { return await get_state(0); }
import "./public/styles.css";

def risk_level(risk: int) -> str { return "Critical" if risk >= 70 else "High" if risk >= 45 else "Watch" if risk >= 25 else "Safe"; }
def risk_class(risk: int) -> str { return "critical" if risk >= 70 else "high" if risk >= 45 else "watch" if risk >= 25 else "safe"; }
def person_class(needs_visit: bool, acknowledged: bool) -> str { return "visit" if needs_visit else "ack" if acknowledged else "pending"; }
def:pub app -> JsxElement {
    has state: DashboardState = DashboardState(), tab: str = "Responder Command", name: str = "Kip", report_text: str = "Water rising at the bridge", report_area: str = "Mukuru", notice: str = "", loading: bool = True, error: bool = False, sms_text: str = "", sms_log: list[str] = [];
    async can with entry { try { state = await fetch_state(); loading = False; error = False; } except Exception { try { state = await run_rainfall(0); loading = False; error = False; } except Exception { loading = False; error = True; } } }
    async def retry { loading = True; try { state = await fetch_state(); error = False; } except Exception { try { state = await run_rainfall(0); error = False; } except Exception { error = True; } } loading = False; }
    async def rain_changed(e: ChangeEvent) { try { state = await run_rainfall(int(e.target.value)); notice = "Warnings sent."; error = False; } except Exception { error = True; notice = "Could not update rainfall."; } }
    async def safe_now { try { state = await acknowledge(name); notice = "Marked safe."; error = False; } except Exception { error = True; } }
    async def fast_forward_now { try { state = await fast_forward(0); notice = "Fast-forward complete."; error = False; } except Exception { error = True; } }
    async def reset_now { try { state = await reset_demo(0); notice = "Demo reset."; error = False; } except Exception { error = True; } }
    async def send_report { try { state = await submit_report(name, report_area, report_text); notice = "Report received."; error = False; } except Exception { error = True; notice = "Could not submit report."; } }
    async def confirm(name_to_confirm: str) { try { state = await confirm_visit(name_to_confirm); notice = "Visit confirmed."; error = False; } except Exception { error = True; } }
    async def relay_again { try { state = await run_rainfall(state.rain); notice = "Warnings sent."; error = False; } except Exception { error = True; } }
    async def send_sms(command: str) { try { reply = await ussd(command); sms_log = sms_log + ["OUT: " + command, "IN: " + reply]; state = await fetch_state(); error = False; } except Exception { error = True; } }
    people_warned = len([p for p in state.people if p.warning]); acknowledged = len([p for p in state.people if p.acknowledged]); critical_count = len([a for a in state.areas if a.risk >= 70]); pending_visits = len([p for p in state.people if p.needs_visit]);
    people_found = [p for p in state.people if p.name == name]; resident = people_found[0] if people_found else PersonView(); area_found = [a for a in state.areas if a.name == resident.area]; resident_area = area_found[0] if area_found else AreaView();
    return <main className="shell">
        <header className="topbar"><div className="brand"><svg viewBox="0 0 40 40" aria-label="Wimbi logo"><circle cx="20" cy="20" r="5"/><circle cx="20" cy="20" r="11"/><circle cx="20" cy="20" r="17"/></svg><div><strong>Wimbi</strong><small>warnings that ripple through trust</small></div></div><nav className="tabs">{for item in ["Resident", "Community Leader", "Responder Command", "Accountability"] { <button className={"tab active" if tab == item else "tab"} onClick={lambda { tab = item; }}>{item}</button> }}</nav><div className="header-actions"><span className="sample">SAMPLE DATA</span><span className="clock">T+{state.minute} min</span><button className="outline" onClick={lambda { reset_now(); }}>Reset demo</button></div></header>
        <div className="status-strip"><span>Rain <b>{state.rain} mm/hr</b></span><span><b>{critical_count}</b> areas critical</span><span><b>{people_warned}</b> people warned</span><span><b>{acknowledged}</b> acknowledged</span></div>
        {notice and <div className="notice">{notice}</div>}
        {if loading { <section className="skeleton-grid"><div className="skeleton"></div><div className="skeleton"></div><div className="skeleton"></div></section> } elif error { <section className="panel error-panel"><h2>Could not load data. Retrying...</h2><button className="primary" onClick={lambda { retry(); }}>Retry</button></section> } else {
            if tab == "Responder Command" { <section className="view"><div className="view-heading"><div><p className="eyebrow">OPERATIONS</p><h1>Responder command</h1><p>Live rainfall, area risk and community reports.</p></div><button className="primary" onClick={lambda { fast_forward_now(); }}>Fast-forward 10 min</button></div><div className="responder-grid"><div className="stack"><article className="panel"><div className="split-head"><div><h2>Rainfall</h2><p>Simulation intensity</p></div><strong className="big-number">{state.rain}<small> mm/hr</small></strong></div><input className="rain-slider" type="range" min="0" max="100" value={str(state.rain)} aria-label="Rainfall intensity" onChange={rain_changed}/><div className="ticks"><span>0 Dry</span><span>30 Heavy</span><span>60 Severe</span><span>100 Extreme</span></div></article><article className="panel"><h2>Risk by area</h2>{state.rain < 30 and <p className="all-clear">Safe. No warnings issued.</p>}<div className="table-scroll"><div className="risk-head"><span>Area and river</span><span>Risk</span><span>ETA</span><span>Roads</span></div>{for a in state.areas { <div className="risk-row"><span><b>{a.name}</b><small>{a.river}</small></span><span><i className={"risk-meter " + risk_class(a.risk)} style={{"width": str(a.risk) + "%"}}></i><b>{a.risk}%</b><small>{risk_level(a.risk)}</small></span><span>{a.eta} min</span><span className="road-text">{a.roads if a.roads else "Open"}</span></div> }}</div></article></div><div className="stack"><article className="panel"><h2>Resource brief</h2><p>{state.resource_brief if state.resource_brief else "No warnings. Keep response teams ready."}</p><div className="resource-list"><span>Shelter</span><span>Medic</span><span>Boat</span></div></article><article className="panel"><h2>Escalations</h2>{pending_visits == 0 and <p className="empty">No silent residents.</p>}{for p in state.people { if p.needs_visit { <p className="escalation">{p.name} needs a visit, asked {p.relay.replace("Visit requested: ", "")}</p> } }}</article><article className="panel"><h2>Reports</h2>{len(state.reports) == 0 and <p className="empty">No reports yet.</p>}{for r in state.reports { <div className="report-line"><span className={"badge " + r.status}>{r.status}</span><div><b>{r.area}</b><p>{r.text}</p><small>{r.reasoning}</small></div></div> }}</article></div></div></section> }
            elif tab == "Community Leader" { <section className="view"><div className="view-heading"><div><p className="eyebrow">TRUST NETWORK</p><h1>Community leader</h1><p>Warnings move through people who already trust one another.</p></div><label className="select-label">Viewing as <select value={name} onChange={lambda (e: ChangeEvent) { name = e.target.value; }}>{for p in state.people { if p.role == "chama_leader" or p.role == "ward_officer" { <option value={p.name}>{p.name} ({p.role.replace("_", " ")})</option> } }}</select></label></div>{pending_visits > 0 and <div className="urgent-banner">{pending_visits} vulnerable people need a visit</div>}<div className="leader-grid"><article className="panel graph-panel"><h2>Trust graph</h2><svg className="trust-svg" viewBox="0 0 520 420" role="img" aria-label="Trust network"><circle cx="260" cy="210" r="142" className="graph-ring"/><line x1="260" y1="210" x2="140" y2="100" stroke="#2DD4BF" stroke-width="4"/><line x1="260" y1="210" x2="380" y2="100" stroke="#2DD4BF" stroke-width="3"/><line x1="260" y1="210" x2="135" y2="315" stroke="#2DD4BF" stroke-width="3"/><line x1="260" y1="210" x2="385" y2="315" stroke="#2DD4BF" stroke-width="2"/><circle cx="140" cy="100" r="29" className="graph-person"/><circle cx="380" cy="100" r="29" className="graph-person"/><circle cx="135" cy="315" r="29" className="graph-person"/><circle cx="385" cy="315" r="29" className="graph-person"/><text x="140" y="105" text-anchor="middle" className="graph-label">Trusted</text><text x="380" y="105" text-anchor="middle" className="graph-label">Circle</text><text x="135" y="320" text-anchor="middle" className="graph-label">People</text><text x="385" y="320" text-anchor="middle" className="graph-label">First</text><circle cx="260" cy="210" r="42" className="graph-center"/><text x="260" y="215" text-anchor="middle" className="graph-label">{name}</text></svg><div className="legend"><span>Pending</span><span>Acknowledged</span><span>Needs visit</span></div></article><article className="panel circle-panel"><h2>My circle</h2>{for p in state.people { <div className="circle-row"><div className={"status-mark " + person_class(p.needs_visit, p.acknowledged)}></div><div className="circle-copy"><b>{p.name}</b><small>{p.role.replace("_", " ")} / {p.language} / {p.area}</small><small>Vulnerability {p.vulnerability} of 5 / {"Needs visit" if p.needs_visit else "Acknowledged" if p.acknowledged else "Pending"}</small>{p.warning and <p>{p.warning}</p>}<details><summary>Show more</summary><p>{p.warning}</p></details></div>{p.needs_visit and <button className="small-outline" onClick={lambda { confirm(p.name); }}>Confirm visit</button>}</div> }}<button className="outline" onClick={lambda { relay_again(); }}>Relay again</button></article></div></section> }
            elif tab == "Resident" { <section className="resident-area"><article className="resident-phone"><div className="notch"></div><label className="identity">I am <select value={name} onChange={lambda (e: ChangeEvent) { name = e.target.value; }}>{for p in state.people { <option value={p.name}>{p.name} ({p.role.replace("_", " ")})</option> }}</select></label>{resident_area.risk < 25 and <div className="resident-alert safe-alert"><b>Safe: All clear</b><small>No flood warning right now.</small></div>}{resident_area.risk >= 25 and <div className={"resident-alert " + risk_class(resident_area.risk)}><b>{risk_level(resident_area.risk)}: water expected in about {resident_area.eta} min</b><small>Status for {resident_area.name}</small></div>}<article className="resident-warning"><span className="language-chip">{resident.language}</span><p>{resident.warning if resident.warning else "No flood warning right now."}</p></article><article className="resident-card"><h2>Avoid these roads</h2><span className="road-danger">{resident_area.roads if resident_area.roads else "No road warnings"}</span><h2>Safe route</h2><span className="road-safe">Use high ground and follow local guidance</span></article><article className="resident-card"><h2>Move first</h2><label><input type="checkbox"/> Gather people and medicine</label><label><input type="checkbox"/> Take documents and phone</label><label><input type="checkbox"/> Move to higher ground</label></article>{(resident.needs_visit or resident.relay) and <div className="neighbour-card">Your neighbour {resident.relay.replace("Visit requested: ", "")} will check on you</div>}<button className="primary safe-button" onClick={lambda { safe_now(); }}>{resident.acknowledged and "You are marked safe" or "I'm safe"}</button><details className="report-sheet"><summary>Report water here</summary><label>Area<select value={report_area} onChange={lambda (e: ChangeEvent) { report_area = e.target.value; }}>{for a in state.areas { <option value={a.name}>{a.name}</option> }}</select></label><textarea value={report_text} onChange={lambda (e: ChangeEvent) { report_text = e.target.value; }} aria-label="Water observation"/><button className="secondary" onClick={lambda { send_report(); }}>Submit report</button>{len(state.reports) > 0 and <div className="verdict"><b>{state.reports[0].status}</b><p>{state.reports[0].reasoning}</p></div>}</details></article></section> }
            elif tab == "Accountability" { warned_count = people_warned; reach = warned_count > 0 and str(int(acknowledged * 100 / warned_count)) + "%" or "-"; first_ack_text = state.first_ack >= 0 and str(state.first_ack) + " min" or "-"; verified_text = state.verified_at >= 0 and str(state.verified_at) + " min" or "-"; <section className="view"><div className="view-heading"><div><p className="eyebrow">OUTCOME MEASUREMENT</p><h1>Accountability</h1><p>Reach and response measured from the shared graph state.</p></div></div><div className="metric-grid"><article className="metric"><small>REACH</small><strong>{reach}</strong><p>Acknowledged / warned</p><span>How measured: acknowledged people divided by warned people.</span></article><article className="metric"><small>FIRST ACKNOWLEDGEMENT</small><strong>{first_ack_text}</strong><p>Time from warning start</p><span>How measured: first acknowledgement after warning.</span></article><article className="metric"><small>ESCALATIONS</small><strong>{state.escalations}</strong><p>Visit requests</p><span>How measured: silent vulnerable residents needing a visit.</span></article><article className="metric"><small>FIRST VERIFIED REPORT</small><strong>{verified_text}</strong><p>Time from warning start</p><span>How measured: first report verification after warning.</span></article></div><div className="leader-grid"><article className="panel"><h2>Acknowledgement by area</h2>{for a in state.areas { total = len([p for p in state.people if p.area == a.name]); done = len([p for p in state.people if p.area == a.name and p.acknowledged]); <div className="bar-row"><span>{a.name}</span><div className="bar-track"><i style={{"width": str(total > 0 and int(done * 100 / total) or 0) + "%"}}></i></div><b>{done}/{total}</b></div> }}</article><article className="panel"><h2>Acknowledgement by role</h2>{for role in ["boda_rider", "tenant_ground_floor", "elderly_resident", "chama_leader", "ward_officer", "mama_mboga"] { total = len([p for p in state.people if p.role == role]); done = len([p for p in state.people if p.role == role and p.acknowledged]); <div className="bar-row"><span>{role.replace("_", " ")}</span><div className="bar-track"><i style={{"width": str(total > 0 and int(done * 100 / total) or 0) + "%"}}></i></div><b>{done}/{total}</b></div> }}</article></div><p className="footnote">Metrics update live from graph state.</p></section> }
            else { <section className="view sms-view"><div className="view-heading"><div><p className="eyebrow">LOW-BANDWIDTH CHANNEL</p><h1>SMS-USSD simulator</h1><p>Works on any phone with no data.</p></div></div><div className="feature-phone"><div className="screen"><b>WIMBI SERVICE</b>{for line in sms_log { <p>{line}</p> }}</div><input value={sms_text} placeholder="Type a command" onChange={lambda (e: ChangeEvent) { sms_text = e.target.value; }}/><button className="primary" onClick={lambda { send_sms(sms_text); }}>Send</button></div><div className="quick-row"><button className="outline" onClick={lambda { send_sms("ACK|" + name); }}>ACK command</button><button className="outline" onClick={lambda { send_sms("REPORT|" + report_area + "|water at bridge"); }}>REPORT command</button><button className="outline" onClick={lambda { send_sms("STATUS|" + report_area); }}>STATUS command</button></div></section> }
        }}
        <footer>All people, places and reports are fictional sample data.</footer>
    </main>;
}
